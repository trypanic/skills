{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/trypanic/skills/tree/main/llmcouncil/schemas/review.schema.json",
  "title": "llmcouncil v1 - review envelope",
  "description": "Stage 2 response envelope returned by a council seat reviewing anonymized responses. Normative contract; scripts/validate.py implements equivalent checks plus the cross-checks noted in $comment.",
  "$comment": "Cross-checks beyond JSON Schema, enforced by the validator: evaluations must cover each issued label exactly once (E-REV-001) and final_ranking must be an exact permutation of the issued labels (E-REV-002).",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "stage", "reviewer", "evaluations", "final_ranking"],
  "properties": {
    "protocol": { "const": "llmcouncil/v1" },
    "stage": { "const": "review" },
    "reviewer": {
      "type": "string",
      "pattern": "^council-[a-z][a-z-]*$",
      "description": "Seat name; must equal the 'seat' field of the request envelope."
    },
    "evaluations": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "strengths", "weaknesses", "scores"],
        "properties": {
          "label": { "type": "string", "pattern": "^[A-Z]$" },
          "strengths": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "weaknesses": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "scores": {
            "type": "object",
            "additionalProperties": false,
            "required": ["accuracy", "insight", "completeness"],
            "properties": {
              "accuracy": { "type": "integer", "minimum": 1, "maximum": 5 },
              "insight": { "type": "integer", "minimum": 1, "maximum": 5 },
              "completeness": { "type": "integer", "minimum": 1, "maximum": 5 }
            }
          }
        }
      }
    },
    "final_ranking": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z]$" },
      "description": "Every issued label exactly once, best first."
    }
  }
}
